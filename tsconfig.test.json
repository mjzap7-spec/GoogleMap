{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "strict": true,
    "skipLibCheck": true,
    "outDir": ".test-build",
    "rootDir": "src",
    "types": ["node"],
    "paths": {
      "react-native": ["./node_modules/react-native/types_generated/index.d.ts"]
    }
  },
  "include": [
    "src/features/interviews/models/**/*.ts",
    "src/features/interviews/viewmodels/**/*.ts",
    "src/features/interviews/data/webrtc/PeerCallMedia.ts",
    "src/features/interviews/data/device/DeviceCallMedia.native.ts",
    "src/features/chat/data/**/*.ts",
    "src/features/chat/models/**/*.ts",
    "src/features/help/models/**/*.ts",
    "src/shared/feedback/**/*.ts",
    "src/shared/platform/directFile.native.ts",
    "src/config/firebase/firestore.native.ts",
    "src/features/map/models/**/*.ts",
    "src/features/map/viewmodels/**/*.ts",
    "src/features/map/data/**/*.ts",
    "src/features/contacts/models/**/*.ts",
    "src/features/contacts/viewmodels/**/*.ts",
    "src/features/contacts/data/**/*.ts",
    "src/shared/mvvm/**/*.ts",
    "src/features/auth/models/**/*.ts",
    "src/features/auth/viewmodels/**/*.ts",
    "src/features/auth/data/firebase/FirebaseAuthRepository.ts",
    "src/features/auth/data/storage/StoredProfileCache.ts",
    "src/features/auth/data/http/OpenMeteoCityRepository.ts",
    "src/features/auth/data/http/CloudinaryAvatarStorage.ts",
    "src/features/auth/bindings/dependencies.ts",
    "src/shared/utils/dateOnly.ts",
    "src/shared/i18n/**/*.ts"
  ]
}
