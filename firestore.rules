rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null; }
  function own(uid) { return signedIn() && request.auth.uid == uid; }
  function profile(uid) { return get(/databases/$(database)/documents/users/$(uid)).data; }
  function nameValid(value) { return value is string && value.size()>0 && value.size()<=100 && value.matches('.*[^ ].*'); }
  function avatarValid(value) { return value == null || (value is string && value.size()<2048 && value.matches('https://.*')); }
  function messageText(value) { return value is string && value.size()<=2000 && value.matches('(?s).*\\S.*'); }
  function validMessageEdit() {
   return resource.data.fromId == request.auth.uid
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','editedAt'])
    && messageText(request.resource.data.text) && request.resource.data.editedAt == request.time;
  }
  function validReply(messagesPath, messageId) {
   let d = request.resource.data;
   return !('replyTo' in d) || (d.replyTo is string && d.replyTo.matches('^[^/]{1,128}$')
    && d.replyTo != messageId && exists(/$(messagesPath)/$(d.replyTo)));
  }
  function validSharedRead(readerId) {
   return own(readerId) && request.resource.data.keys().hasOnly(['through'])
    && request.resource.data.through is timestamp && request.resource.data.through <= request.time;
  }
  function connected(uid, peer) {
   return exists(/databases/$(database)/documents/users/$(uid)/contacts/$(peer))
    && exists(/databases/$(database)/documents/users/$(peer)/contacts/$(uid))
    && get(/databases/$(database)/documents/users/$(uid)/contacts/$(peer)).data.peerId == peer
    && get(/databases/$(database)/documents/users/$(peer)/contacts/$(uid)).data.peerId == uid;
  }
  match /users/{userId} {
   allow get: if own(userId) || (signedIn() && connected(userId, request.auth.uid));
   allow list: if false;
   allow delete: if own(userId);
   function validProfile() {
    return request.resource.data.keys().hasAll(['fullName','birthday','location','avatarUrl','createdAt'])
     && request.resource.data.keys().hasOnly(['fullName','birthday','location','avatarUrl','createdAt'])
     && nameValid(request.resource.data.fullName)
     && request.resource.data.birthday is string && request.resource.data.birthday.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
     && request.resource.data.location is string && request.resource.data.location.size()>0 && request.resource.data.location.size()<=120
     && (request.resource.data.avatarUrl == null || (request.resource.data.avatarUrl is string && request.resource.data.avatarUrl.size()<2048));
   }
   allow create: if own(userId) && validProfile() && request.resource.data.createdAt == request.time;
   allow update: if own(userId) && validProfile() && request.resource.data.createdAt == resource.data.createdAt;
   match /private/{detailId} {
    allow get, delete: if own(userId) && detailId == 'phone';
    allow create, update: if own(userId) && detailId == 'phone'
     && request.resource.data.keys().hasAll(['phoneNumber'])
     && request.resource.data.keys().hasOnly(['phoneNumber'])
     && request.resource.data.phoneNumber is string
     && (request.resource.data.phoneNumber == '' || request.resource.data.phoneNumber.matches('^[+]?[0-9]{7,15}$'));
   }
   match /preferences/{preferenceId} {
    allow read: if own(userId);
    allow create, update: if own(userId) && preferenceId == 'sharing'
     && request.resource.data.keys().hasOnly(['nearby','groups'])
     && request.resource.data.nearby is bool && request.resource.data.groups is bool
     && !(request.resource.data.nearby && request.resource.data.groups)
     && (request.resource.data.nearby || !existsAfter(/databases/$(database)/documents/sharedLocations/$(userId)));
   }
   match /formerGroups/{groupId} {
    function leftGroup() {
     let path = /databases/$(database)/documents/privateGroups/$(groupId);
     let before = get(path).data;
     let after = getAfter(path).data;
     return userId in before.joinedIds && before.ownerId != userId
      && !(userId in after.memberIds) && !(userId in after.joinedIds)
      && request.resource.data.keys().hasOnly(['name']) && request.resource.data.name == before.name;
    }
    allow read, delete: if own(userId);
    allow create, update: if own(userId) && leftGroup();
   }
   match /chatReads/{threadId} {
    allow read: if own(userId);
    function validRead() {
     return own(userId) && request.resource.data.keys().hasOnly(['through'])
      && request.resource.data.through is timestamp && request.resource.data.through <= request.time;
    }
    allow create: if validRead();
    allow update: if validRead() && request.resource.data.through >= resource.data.through;
   }
   match /chatInbox/{peerId} {
    allow read: if own(userId);
    function validPreview() {
     let d = request.resource.data;
     let thread = get(/databases/$(database)/documents/users/$(userId)/contacts/$(peerId)).data.requestId;
     let path = /databases/$(database)/documents/contactRequests/$(thread)/messages/$(d.messageId);
     let msg = getAfter(path).data;
     return d.keys().hasOnly(['messageId','requestId','text','updatedAt']) && d.requestId == thread
      && d.text == msg.text && msg.fromId == request.auth.uid
      && ((d.updatedAt == request.time && msg.createdAt == request.time)
       || (resource.data.messageId == d.messageId && d.updatedAt == resource.data.updatedAt
        && msg.editedAt == request.time));
    }
    function deletedPreview() {
     let d = request.resource.data;
     let path = /databases/$(database)/documents/contactRequests/$(resource.data.requestId)/messages/$(resource.data.messageId);
     return d.diff(resource.data).affectedKeys().hasOnly(['text']) && d.text == ''
      && get(path).data.fromId == request.auth.uid && !existsAfter(path);
    }
    allow create, update: if signedIn() && request.auth.uid in [userId,peerId]
     && connected(userId,peerId) && validPreview();
    allow update: if signedIn() && request.auth.uid in [userId,peerId]
     && connected(userId,peerId) && deletedPreview();
   }
   match /contactEvents/{eventId} {
    allow read, delete: if own(userId);
    function validEvent() {
     let d = request.resource.data;
     return signedIn() && d.keys().hasOnly(['kind','actorId','name','requestId','createdAt'])
      && d.actorId == request.auth.uid && d.actorId != userId
      && d.name == profile(d.actorId).fullName && d.createdAt == request.time;
    }
    function responseEvent() {
     let d = request.resource.data;
     let before = get(/databases/$(database)/documents/contactRequests/$(d.requestId)).data;
     let after = getAfter(/databases/$(database)/documents/contactRequests/$(d.requestId)).data;
     return (d.kind == 'accepted' || d.kind == 'declined') && before.fromId == userId && before.toId == request.auth.uid
      && before.status == 'pending' && after.status == d.kind;
    }
    function removedEvent() {
     let d = request.resource.data;
     let peer = get(/databases/$(database)/documents/users/$(userId)/contacts/$(d.actorId)).data;
     return d.kind == 'removed' && connected(userId, d.actorId) && peer.requestId == d.requestId
      && !existsAfter(/databases/$(database)/documents/users/$(userId)/contacts/$(d.actorId))
      && !existsAfter(/databases/$(database)/documents/users/$(d.actorId)/contacts/$(userId));
    }
    allow create: if validEvent() && (responseEvent() || removedEvent());
    allow update: if own(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ackFor'])
     && request.resource.data.ackFor == resource.data.createdAt.toMillis();
   }
   match /contacts/{contactId} {
    allow read: if own(userId);
    function legacy() { return request.resource.data.keys().hasOnly(['name','createdAt']) && nameValid(request.resource.data.name) && request.resource.data.createdAt == request.time; }
    function acceptedPair() {
     let data=request.resource.data;
     let before=get(/databases/$(database)/documents/contactRequests/$(data.requestId)).data;
     let after=getAfter(/databases/$(database)/documents/contactRequests/$(data.requestId)).data;
     let other=getAfter(/databases/$(database)/documents/users/$(contactId)/contacts/$(userId)).data;
     return signedIn() && data.keys().hasOnly(['name','peerId','requestId','createdAt'])
      && data.peerId == contactId && userId != contactId && nameValid(data.name) && data.createdAt == request.time
      && before.status == 'pending' && before.toId == request.auth.uid && after.status == 'accepted'
      && ((before.fromId == userId && before.toId == contactId && data.name == profile(contactId).fullName)
       || (before.toId == userId && before.fromId == contactId && data.name == before.fromName))
      && other.peerId == userId && other.requestId == data.requestId;
    }
    allow create: if (own(userId) && legacy()) || acceptedPair();
    allow update: if own(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']) && nameValid(request.resource.data.name);
    allow delete: if own(userId) && !('peerId' in resource.data)
     || (signedIn() && (request.auth.uid == userId || request.auth.uid == contactId) && resource.data.peerId == contactId
      && !existsAfter(/databases/$(database)/documents/users/$(contactId)/contacts/$(userId)));
   }
  }
  match /contactDirectory/{email} {
   allow get: if signedIn();
   allow list: if false;
   allow create, update: if signedIn() && request.auth.token.email is string && email == request.auth.token.email.lower()
    && request.resource.data.keys().hasOnly(['uid','email','fullName','avatarUrl','updatedAt'])
    && request.resource.data.uid == request.auth.uid && request.resource.data.email == email
    && request.resource.data.fullName == profile(request.auth.uid).fullName
    && request.resource.data.avatarUrl == profile(request.auth.uid).avatarUrl && request.resource.data.updatedAt == request.time
    && (!exists(/databases/$(database)/documents/contactDirectory/$(email)) || resource.data.uid == request.auth.uid);
   allow delete: if signedIn() && resource.data.uid == request.auth.uid;
  }
  match /contactRequests/{requestId} {
   function canChat() {
     let pair = get(/databases/$(database)/documents/contactRequests/$(requestId)).data;
     return signedIn() && request.auth.uid in [pair.fromId,pair.toId] && pair.status == 'accepted'
      && connected(pair.fromId,pair.toId)
      && get(/databases/$(database)/documents/users/$(pair.fromId)/contacts/$(pair.toId)).data.requestId == requestId;
   }
   match /reads/{readerId} {
    allow read: if canChat();
    allow create: if canChat() && validSharedRead(readerId);
    allow update: if canChat() && validSharedRead(readerId) && request.resource.data.through >= resource.data.through;
   }
   match /messages/{messageId} {
    allow read: if canChat();
    allow create: if canChat() && request.resource.data.keys().hasOnly(['fromId','text','createdAt','replyTo'])
     && request.resource.data.fromId == request.auth.uid && request.resource.data.createdAt == request.time
     && messageText(request.resource.data.text)
     && validReply(/databases/$(database)/documents/contactRequests/$(requestId)/messages, messageId);
    allow update: if canChat() && validMessageEdit();
    allow delete: if canChat() && resource.data.fromId == request.auth.uid;
   }
   allow get: if signedIn() && (!exists(/databases/$(database)/documents/contactRequests/$(requestId)) || resource.data.fromId == request.auth.uid || resource.data.toId == request.auth.uid);
   allow list: if signedIn() && (resource.data.fromId == request.auth.uid || resource.data.toId == request.auth.uid) && request.query.limit <= 100;
   function visibleTarget(uid) {
    let presence=get(/databases/$(database)/documents/sharedLocations/$(uid)).data;
    let bucket=int(request.time.toMillis() / 120000);
    return exists(/databases/$(database)/documents/users/$(uid))
     && presence.bucket >= bucket-1 && presence.bucket <= bucket;
   }
   function sharedGroupTarget(data) {
    let group=get(/databases/$(database)/documents/privateGroups/$(data.groupId)).data;
    return data.fromId in group.joinedIds && data.toId in group.joinedIds;
   }
   function validRequest() {
    let d=request.resource.data;
    let reverse=d.toId+'_'+d.fromId;
    return signedIn() && d.keys().hasOnly(['groupId','fromId','toId','fromName','fromEmail','toEmail','status','createdAt','updatedAt'])
     && d.fromId == request.auth.uid && d.fromId != d.toId && requestId == d.fromId+'_'+d.toId
     && d.fromEmail == request.auth.token.email.lower() && d.fromName == profile(d.fromId).fullName
     && d.toEmail is string && ((d.toEmail == '' && (('groupId' in d && sharedGroupTarget(d)) || (!('groupId' in d) && visibleTarget(d.toId))))
     || (d.toEmail != '' && get(/databases/$(database)/documents/contactDirectory/$(d.toEmail)).data.uid == d.toId))
     && d.status == 'pending' && d.updatedAt == request.time
     && !exists(/databases/$(database)/documents/users/$(d.fromId)/contacts/$(d.toId))
     && (!exists(/databases/$(database)/documents/contactRequests/$(reverse)) || get(/databases/$(database)/documents/contactRequests/$(reverse)).data.status != 'pending');
   }
   allow create: if validRequest() && request.resource.data.createdAt == request.time;
   allow update: if signedIn() && resource.data.toId==request.auth.uid && resource.data.status=='pending'
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ackFor'])
    && request.resource.data.ackFor==resource.data.updatedAt.toMillis();
   allow update: if (validRequest() && resource.data.status != 'pending'
      && request.time > resource.data.updatedAt + duration.value(1,'m')
      && request.resource.data.createdAt == resource.data.createdAt
      && request.resource.data.fromId == resource.data.fromId && request.resource.data.toId == resource.data.toId)
    || (signedIn() && resource.data.toId == request.auth.uid && resource.data.status == 'pending'
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt','toEmail'])
      && (request.resource.data.toEmail == resource.data.toEmail || (resource.data.toEmail == '' && request.resource.data.toEmail == request.auth.token.email.lower()))
      && request.resource.data.updatedAt == request.time
      && (request.resource.data.status == 'declined' || (request.resource.data.status == 'accepted'
       && getAfter(/databases/$(database)/documents/users/$(resource.data.fromId)/contacts/$(resource.data.toId)).data.requestId == requestId
       && getAfter(/databases/$(database)/documents/users/$(resource.data.toId)/contacts/$(resource.data.fromId)).data.requestId == requestId)));
  }
  match /groupDirectory/{groupId} {
   function groupPath() { return /databases/$(database)/documents/privateGroups/$(groupId); }
   function listing() {
    let group=getAfter(groupPath()).data;
    let d=request.resource.data;
    return group.ownerId==request.auth.uid && d.keys().hasOnly(['active','name','createdAt','creatorName','memberCount'])
     && d.active==true && d.name==group.name && d.createdAt==request.time
     && d.creatorName==profile(request.auth.uid).fullName && d.memberCount is int && d.memberCount==group.joinedIds.size();
   }
   function membershipCount() {
    let after=getAfter(groupPath()).data;
    return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount'])
     && request.resource.data.memberCount is int && request.resource.data.memberCount==after.joinedIds.size()
     && (request.auth.uid in after.joinedIds || request.auth.uid in get(groupPath()).data.joinedIds);
   }
   function retired() {
    return request.resource.data.keys().hasOnly(['active']) && request.resource.data.active==false
     && get(groupPath()).data.ownerId==request.auth.uid && !existsAfter(groupPath());
   }
   allow get, list: if signedIn() && resource.data.active==true;
   allow create: if signedIn() && (listing() || retired());
   allow update: if signedIn() && resource.data.active && (retired() || membershipCount());
  }
  match /privateGroups/{groupId} {
   function directoryPath(){return /databases/$(database)/documents/groupDirectory/$(groupId);}
   function invited() { return signedIn() && request.auth.uid in resource.data.memberIds; }
   function joined() { return signedIn() && request.auth.uid in get(/databases/$(database)/documents/privateGroups/$(groupId)).data.joinedIds; }
   function pairMember(first, second) {
    let members=get(/databases/$(database)/documents/privateGroups/$(groupId)).data.joinedIds;
    return signedIn() && request.auth.uid in [first,second] && first < second
     && first in members && second in members;
   }
   function validGroup() {
    let d=request.resource.data;
    return d.keys().hasOnly(['name','ownerId','memberIds','joinedIds']) && nameValid(d.name) && d.name.size()<=60
     && d.memberIds is list && d.joinedIds is list && d.memberIds.size()<=10
     && d.memberIds.toSet().size()==d.memberIds.size() && d.joinedIds.toSet().size()==d.joinedIds.size()
     && d.joinedIds.toSet().hasOnly(d.memberIds) && d.ownerId in d.joinedIds;
   }
   function inviteContact() {
    let added=request.resource.data.memberIds.removeAll(resource.data.memberIds);
    return resource.data.ownerId==request.auth.uid
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
     && request.resource.data.memberIds.hasAll(resource.data.memberIds) && added.size()==1
     && connected(request.auth.uid,added[0]);
   }
   function acceptInvitation() {
    return invited() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['joinedIds'])
     && request.resource.data.joinedIds==resource.data.joinedIds.concat([request.auth.uid])
     && !(request.auth.uid in resource.data.joinedIds);
   }
   function leaveGroup() {
    return invited() && request.auth.uid!=resource.data.ownerId
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds','joinedIds'])
     && request.resource.data.memberIds==resource.data.memberIds.removeAll([request.auth.uid])
     && request.resource.data.joinedIds==resource.data.joinedIds.removeAll([request.auth.uid]);
   }
   function joinFromDirectory() {
    let uid=request.auth.uid;
    return get(directoryPath()).data.active && !(uid in resource.data.memberIds)
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds','joinedIds'])
     && request.resource.data.memberIds==resource.data.memberIds.concat([uid])
     && request.resource.data.joinedIds==resource.data.joinedIds.concat([uid]);
   }
   allow get, list: if invited();
   allow create: if signedIn() && validGroup() && request.resource.data.ownerId==request.auth.uid
    && request.resource.data.memberIds==[request.auth.uid] && request.resource.data.joinedIds==[request.auth.uid]
    && !exists(directoryPath()) && getAfter(directoryPath()).data.active==true;
   allow update: if signedIn() && validGroup() && (inviteContact() || acceptInvitation() || leaveGroup() || joinFromDirectory())
    && (resource.data.joinedIds == request.resource.data.joinedIds
     || getAfter(directoryPath()).data.memberCount == request.resource.data.joinedIds.size());
   allow delete: if signedIn() && resource.data.ownerId==request.auth.uid && getAfter(directoryPath()).data.active==false;
   match /members/{memberId} {
    allow read: if joined();
    allow create, update: if own(memberId)
     && memberId in getAfter(/databases/$(database)/documents/privateGroups/$(groupId)).data.joinedIds
     && request.resource.data.keys().hasOnly(['name','avatarUrl'])
     && request.resource.data.name==profile(memberId).fullName && request.resource.data.avatarUrl==profile(memberId).avatarUrl;
    allow delete: if own(memberId);
   }
   match /memberChats/{first}/with/{second}/reads/{readerId} {
    allow read: if pairMember(first, second);
    allow create: if pairMember(first, second) && validSharedRead(readerId);
    allow update: if pairMember(first, second) && validSharedRead(readerId) && request.resource.data.through >= resource.data.through;
   }
   match /memberChats/{first}/with/{second}/messages/{messageId} {
    allow read: if pairMember(first, second);
    allow create: if pairMember(first, second) && request.resource.data.keys().hasOnly(['fromId','text','createdAt','replyTo'])
     && request.resource.data.fromId==request.auth.uid && request.resource.data.createdAt==request.time
     && messageText(request.resource.data.text)
     && validReply(/databases/$(database)/documents/privateGroups/$(groupId)/memberChats/$(first)/with/$(second)/messages, messageId);
    allow update: if pairMember(first, second) && validMessageEdit();
    allow delete: if pairMember(first, second) && resource.data.fromId == request.auth.uid;
   }
   match /reads/{readerId} {
    allow read: if joined();
    allow create: if joined() && validSharedRead(readerId);
    allow update: if joined() && validSharedRead(readerId) && request.resource.data.through >= resource.data.through;
   }
   match /messages/{messageId} {
    allow read: if joined();
    allow create: if joined() && request.resource.data.keys().hasOnly(['fromId','senderName','text','createdAt','replyTo'])
     && request.resource.data.fromId==request.auth.uid && request.resource.data.senderName==profile(request.auth.uid).fullName
     && request.resource.data.createdAt==request.time && messageText(request.resource.data.text)
     && validReply(/databases/$(database)/documents/privateGroups/$(groupId)/messages, messageId);
    allow update: if joined() && validMessageEdit();
    allow delete: if joined() && resource.data.fromId == request.auth.uid;
   }
   match /live/{memberId} {
    allow read: if joined();
    allow delete: if own(memberId);
    allow create, update: if own(memberId) && joined()
     && request.resource.data.keys().hasOnly(['nickname','avatarUrl','latitude','longitude','trip','trail','updatedAt'])
     && request.resource.data.nickname==profile(memberId).fullName
     && request.resource.data.avatarUrl==profile(memberId).avatarUrl
     && request.resource.data.latitude is number && request.resource.data.latitude>=-90 && request.resource.data.latitude<=90
     && request.resource.data.longitude is number && request.resource.data.longitude>=-180 && request.resource.data.longitude<=180
     && request.resource.data.trip is bool && request.resource.data.trail is string && request.resource.data.trail.size()<=100000
     && (request.resource.data.trip || get(/databases/$(database)/documents/users/$(memberId)/preferences/sharing).data.groups==true)
     && request.resource.data.updatedAt==request.time;
   }
  }
  // One-to-one interview signaling. Audio/video never passes through Firestore.
  match /interviewCalls/{callId} {
   function participant(d) { return signedIn() && request.auth.uid in [d.fromId,d.toId]; }
   function contextAllowed(d) {
    return (d.kind == 'contact' && connected(d.fromId,d.toId)
     && get(/databases/$(database)/documents/users/$(d.fromId)/contacts/$(d.toId)).data.requestId == d.contextId
     && get(/databases/$(database)/documents/users/$(d.toId)/contacts/$(d.fromId)).data.requestId == d.contextId
     && get(/databases/$(database)/documents/contactRequests/$(d.contextId)).data.status == 'accepted')
     || (d.kind == 'group'
      && d.fromId in get(/databases/$(database)/documents/privateGroups/$(d.contextId)).data.joinedIds
      && d.toId in get(/databases/$(database)/documents/privateGroups/$(d.contextId)).data.joinedIds);
   }
   function description(d, type) {
    return d is map && d.keys().hasOnly(['type','sdp']) && d.type == type
     && d.sdp is string && d.sdp.size()>0 && d.sdp.size()<=100000;
   }
   function validCreate(d) {
    return d.keys().hasOnly(['fromId','toId','fromName','fromAvatar','kind','contextId','mode','status','offer','createdAt','expiresAt','validUntil'])
     && d.fromId == request.auth.uid && d.toId is string && d.toId != d.fromId
     && nameValid(d.fromName) && d.fromName == profile(d.fromId).fullName
     && avatarValid(d.fromAvatar) && d.fromAvatar == profile(d.fromId).avatarUrl
     && d.contextId is string && d.contextId.size()>0 && d.contextId.size()<=256
     && d.mode in ['voice','video'] && d.status == 'ringing' && description(d.offer,'offer')
     && d.createdAt == request.time
     && d.expiresAt is timestamp && d.expiresAt>request.time && d.expiresAt<=request.time+duration.value(90,'s')
     && d.validUntil is timestamp && d.validUntil>d.expiresAt && d.validUntil<=request.time+duration.value(7230,'s')
     && contextAllowed(d);
   }
   function validAccept() {
    return own(resource.data.toId) && resource.data.status == 'ringing'
     && resource.data.expiresAt>request.time && contextAllowed(resource.data)
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','answer'])
     && request.resource.data.status == 'accepted' && description(request.resource.data.answer,'answer');
   }
   function validEnd() {
    return resource.data.status in ['ringing','accepted']
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','endedAt'])
     && request.resource.data.endedAt == request.time
     && (request.resource.data.status == 'ended' || (own(resource.data.toId)
      && resource.data.status == 'ringing' && request.resource.data.status in ['declined','busy']));
   }
   allow get: if participant(resource.data);
   allow list: if own(resource.data.toId) && request.query.limit<=10;
   allow create: if signedIn() && validCreate(request.resource.data);
   function validConnected() {
    return resource.data.status == 'accepted' && resource.data.validUntil > request.time
     && !('connectedAt' in resource.data)
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['connectedAt'])
     && request.resource.data.connectedAt == request.time;
   }
   allow update: if participant(resource.data) && (validAccept() || validEnd() || validConnected());
   allow delete: if false;
   match /candidates/{candidateId} {
    function call() { return get(/databases/$(database)/documents/interviewCalls/$(callId)).data; }
    function validCandidate(d) {
     return d.keys().hasOnly(['fromId','index','candidate','sdpMid','sdpMLineIndex'])
      && d.fromId == request.auth.uid && d.index is int && d.index>=0 && d.index<64
      && candidateId == request.auth.uid+'_'+string(d.index)
      && d.candidate is string && d.candidate.size()>0 && d.candidate.size()<=8192
      && (d.sdpMid == null || (d.sdpMid is string && d.sdpMid.size()<=256))
      && (d.sdpMLineIndex == null || (d.sdpMLineIndex is int && d.sdpMLineIndex>=0 && d.sdpMLineIndex<=65535));
    }
    allow read: if participant(call());
    allow create: if participant(call()) && contextAllowed(call()) && call().validUntil>request.time
     && (call().status == 'accepted' || (call().status == 'ringing' && call().expiresAt>request.time))
     && validCandidate(request.resource.data);
    allow update: if false;
    allow delete: if participant(call());
   }
  }
  match /sharedLocations/{userId} {
   function currentBucket() { return int(request.time.toMillis() / 120000); }
   function fresh() { return resource.data.bucket >= currentBucket()-1 && resource.data.bucket <= currentBucket(); }
   function publicAudience() {
    let path = /databases/$(database)/documents/users/$(userId)/preferences/sharing;
    return !exists(path) || (get(path).data.nearby == true && get(path).data.groups == false);
   }
   allow get: if signedIn() && (!exists(/databases/$(database)/documents/sharedLocations/$(userId)) || (fresh() && publicAudience()));
   allow list: if signedIn() && fresh() && request.query.limit <= 200;
   allow create, update: if own(userId)
    && (!existsAfter(/databases/$(database)/documents/users/$(userId)/preferences/sharing)
     || (getAfter(/databases/$(database)/documents/users/$(userId)/preferences/sharing).data.nearby == true
      && getAfter(/databases/$(database)/documents/users/$(userId)/preferences/sharing).data.groups == false))
    && request.resource.data.keys().hasOnly(['nickname','avatarUrl','latitude','longitude','geohash','bucket','updatedAt'])
    && request.resource.data.nickname == profile(userId).fullName && avatarValid(request.resource.data.avatarUrl) && request.resource.data.avatarUrl == profile(userId).avatarUrl
    && request.resource.data.latitude is number && request.resource.data.latitude >= -90 && request.resource.data.latitude <= 90
    && request.resource.data.longitude is number && request.resource.data.longitude >= -180 && request.resource.data.longitude <= 180
    && request.resource.data.geohash is string && request.resource.data.geohash.size() == 10
    && request.resource.data.bucket == currentBucket() && request.resource.data.updatedAt == request.time;
   allow delete: if own(userId);
  }
 }
}
