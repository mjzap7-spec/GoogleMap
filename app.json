{
  "expo": {
    "name": "Google Map",
    "slug": "nest-auth",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/google-maps.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "backgroundColor": "#101116"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#101116",
        "foregroundImage": "./assets/brand/google-maps.png"
      },
      "predictiveBackGestureEnabled": false,
      "backgroundColor": "#101116",
      "package": "com.anonymous.nestauth"
    },
    "web": {
      "favicon": "./assets/brand/google-maps.png",
      "name": "Google Map"
    },
    "scheme": "nest-auth",
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Use your microphone during an interview you start or accept.",
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#101116",
          "image": "./assets/brand/google-maps.png",
          "imageWidth": 144,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo for your profile avatar.",
          "microphonePermission": "Use your microphone during an interview you start or accept.",
          "cameraPermission": "Use your camera during a video interview you start or accept."
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Use your camera during a video interview you start or accept.",
          "microphonePermission": "Use your microphone during an interview you start or accept."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Show your current position and draw the path you travel while the map is open.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      "./plugins/withShortAndroidObjectPaths.js",
      "./plugins/withAndroidDevSupport.js",
      "./plugins/withFirestoreStreaming.js"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "backgroundColor": "#101116"
  }
}
