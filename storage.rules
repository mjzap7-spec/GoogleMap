// Legacy Firebase Storage rules; avatar uploads now use Cloudinary.
// Retained for previously uploaded files. Not deployed by firebase.json.
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /avatars/{userId}/{avatarId} {
      function owner() { return request.auth != null && request.auth.uid == userId; }
      allow read, delete: if owner();
      allow create, update: if owner()
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }
  }
}
