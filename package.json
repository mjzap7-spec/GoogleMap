{
  "name": "mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-google-signin/google-signin": "^17.0.0",
    "expo": "~58.0.21",
    "expo-constants": "~58.0.14",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.15",
    "expo-location": "~58.0.20",
    "expo-router": "~58.0.28",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "firebase": "^13.1.0",
    "geofire-common": "^6.0.0",
    "react": "19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "android:open": "node scripts/open-emulators.cjs",
    "android:dev": "node scripts/start-emulators.cjs",
    "android:route": "node scripts/play-route.cjs",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test:build": "tsc -p tsconfig.test.json",
    "test": "node scripts/test.cjs",
    "lint": "eslint .",
    "format": "prettier --write src tests scripts docs README.md CONTRIBUTING.md eslint.config.js",
    "format:check": "prettier --check src tests scripts docs README.md CONTRIBUTING.md eslint.config.js",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "test:rules": "npm run test:build && firebase emulators:exec --only firestore --project demo-google-map-social \"node --test tests/firestore/social.rules.cjs\""
  },
  "private": true
}
